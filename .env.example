# .env
APP_ENV=development
LOG_LEVEL=INFO

# Postgres credentials
POSTGRES_USER=meet_bot_user
POSTGRES_PASSWORD=super_secret_password
POSTGRES_DB=english_meet_db
DB_HOST=localhost
DB_PORT=5432

# Google Chat
# Audience из поля "Authentication audience" в Chat App Configuration
# (обычно это URL endpoint'а, который ты туда вписал)
CHAT_APP_AUDIENCE=https://<твой-домен>.ngrok-free.app/webhooks/google-chat
SKIP_JWT_VALIDATION=false

# Сервисный аккаунт для проактивных DM-рассылок (файл НЕ коммитить)
GOOGLE_SA_KEY_FILE=sa-key.json

# Твой DM-space с ботом (виден после первого сообщения боту, например spaces/XXXX)
CHAT_TEST_SPACE=

# Таймзона бота: «сегодня» (запрет голосования за прошедшие дни) и ежедневная
# проверка в 20:00 считаются в этом поясе
APP_TZ=Europe/Moscow

# Общая группа Google Chat (spaces/XXXX) — сюда дублируются уведомления о встрече
# и карточка опроса. Пока пусто — бот шлёт только в DM участникам.
CHAT_GROUP_SPACE=
